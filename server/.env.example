# Keep real .env files out of Git. Configure this in your host's secret manager in production.
PORT=8787
GROQ_API_KEY=replace-with-a-server-side-groq-key
GROQ_MODEL=openai/gpt-oss-20b
DAILY_LIMIT=50
MAX_INPUT_CHARS=8000
IP_REQUESTS_PER_WINDOW=30
IP_RATE_WINDOW_MS=900000
# Comma-separated; add the exact chrome-extension://<published-id> after the first store upload.
ALLOWED_ORIGINS=chrome-extension://replace-with-published-extension-id
# Use a persistent mounted volume in production; local SQLite is suitable for one server instance.
DATABASE_PATH=./data/textai.sqlite
# Set to false only if the server is not behind a trusted reverse proxy.
TRUST_PROXY=1
